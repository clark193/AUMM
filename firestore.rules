rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function adminProfile() {
      return get(/databases/$(database)/documents/adminRoles/$(request.auth.uid));
    }
    function superAdmin() {
      return signedIn() && adminProfile().data.active == true && adminProfile().data.superAdmin == true;
    }
    function hasPermission(permission) {
      return superAdmin() || (signedIn() && adminProfile().data.active == true && adminProfile().data.permissions[permission] == true);
    }
    function own(uid) { return signedIn() && request.auth.uid == uid; }
    function validApplication(id) {
      return signedIn()
        && request.resource.data.keys().hasOnly([
          'applicationId','fullName','email','phone','city','consent','consentVersion','consentAt',
          'applicantUid','status','createdAt'
        ])
        && request.resource.data.applicationId == id
        && request.resource.data.applicantUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.consent == true
        && request.resource.data.createdAt == request.time
        && request.resource.data.consentAt == request.time
        && request.resource.data.fullName is string && request.resource.data.fullName.size() >= 3 && request.resource.data.fullName.size() <= 160
        && request.resource.data.email is string && request.resource.data.email.size() <= 254
        && request.resource.data.phone is string && request.resource.data.phone.size() >= 10 && request.resource.data.phone.size() <= 30
        && request.resource.data.city is string && request.resource.data.city.size() >= 2 && request.resource.data.city.size() <= 100;
    }
    match /associationApplications/{id} {
      allow create: if validApplication(id);
      allow read: if (signedIn() && resource.data.applicantUid == request.auth.uid) || hasPermission('applications.read');
      allow update: if hasPermission('applications.review');
      allow delete: if superAdmin();
    }
    match /users/{uid} {
      allow read: if own(uid) || hasPermission('users.read');
      allow create: if own(uid) && request.resource.data.adminRole == null;
      allow update: if (own(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['phone','whatsapp','address','photoURL','updatedAt'])) || hasPermission('users.update');
      allow delete: if superAdmin();
    }
    match /associados/{id} {
      allow read: if (signedIn() && resource.data.uid == request.auth.uid) || hasPermission('members.read');
      allow create, update: if hasPermission('members.write');
      allow delete: if superAdmin();
    }
    match /publicMembers/{token} {
      allow read: if true;
      allow write: if hasPermission('members.write');
    }
    match /roles/{id} {
      allow read: if resource.data.active == true || signedIn();
      allow write: if hasPermission('roles.manage');
    }
    match /adminRoles/{id} {
      allow read: if own(id) || hasPermission('admins.read');
      allow write: if superAdmin();
    }
    match /news/{id} {
      allow read: if resource.data.status == 'published' || hasPermission('news.read');
      allow create: if hasPermission('news.create');
      allow update: if hasPermission('news.edit');
      allow delete: if hasPermission('news.delete');
    }
    match /communications/{id} {
      allow read: if signedIn() && (resource.data.audience == 'all' || resource.data.userIds.hasAny([request.auth.uid]) || request.auth.token.roles.hasAny(resource.data.roleIds)) || hasPermission('communications.read');
      allow write: if hasPermission('communications.write');
    }
    match /{collectionName}/{id} {
      allow read: if collectionName in ['partners','benefits','events'] && resource.data.status == 'active';
      allow write: if collectionName in ['partners','benefits','events'] && hasPermission('content.manage');
    }
    match /documents/{id} {
      allow read: if resource.data.visibility == 'public' || (signedIn() && resource.data.visibility == 'member') || hasPermission('documents.read');
      allow write: if hasPermission('documents.write');
    }
    match /requests/{id} {
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow read: if signedIn() && resource.data.ownerUid == request.auth.uid || hasPermission('requests.read');
      allow update: if signedIn() && resource.data.ownerUid == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberReply','updatedAt']) || hasPermission('requests.write');
      allow delete: if superAdmin();
    }
    match /financialEntries/{id} {
      allow read: if resource.data.visibility == 'public' || hasPermission('finance.read');
      allow write: if hasPermission('finance.write');
    }
    match /transparency/{id} {
      allow read: if resource.data.status == 'published';
      allow write: if hasPermission('transparency.write');
    }
    match /settings/{id} {
      allow read: if id in ['public','cardPublic'] || hasPermission('settings.read');
      allow write: if hasPermission('settings.write');
    }
    match /notifications/{id} {
      allow read, update: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if hasPermission('notifications.write');
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }
    match /auditLogs/{id} {
      allow read: if hasPermission('audit.read');
      allow create: if signedIn();
      allow update, delete: if false;
    }
    match /counters/{id} { allow read, write: if false; }
    match /applicationKeys/{id} { allow read, write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
