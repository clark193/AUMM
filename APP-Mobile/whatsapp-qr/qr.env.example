# Preencher somente no armazenamento seguro do servidor. Não são credenciais reais.
WA_QR_ENABLED=false
WA_QR_SEND_ENABLED=false
WA_QR_PUBLIC=false
# Remetentes autorizados: JID pessoal completo, separado por vírgula.
WA_QR_ALLOWED_JIDS=
