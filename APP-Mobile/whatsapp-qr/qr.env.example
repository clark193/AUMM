# 32 bytes aleatórios em base64; manter a mesma chave entre local e nuvem.
WA_QR_SESSION_KEY=
GOOGLE_CLOUD_PROJECT=aumm-21dda
# Credencial administrativa existente em secret/arquivo protegido; nunca no frontend.
FIREBASE_SERVICE_ACCOUNT=
