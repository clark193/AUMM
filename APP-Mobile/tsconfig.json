{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noEmit": true,
    "types": ["vite/client", "node"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["../*"],
      "next/navigation": ["src/portal/navigation.ts"],
      "next/link": ["src/portal/Link.tsx"],
      "next/image": ["src/portal/Image.tsx"]
    }
  },
  "include": ["src"]
}
