{
  "name": "aumm-plataforma",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "dev:next": "next dev",
    "build:firebase": "next build",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --experimental-strip-types --test tests/assembly-rules.test.ts tests/rendered-html.test.mjs",
    "test:rules": "npx firebase-tools emulators:exec --only firestore \"node --test tests/firestore-assemblies.rules.test.mjs\"",
    "seed:assembly:emulator": "node scripts/seed-assembly-emulator.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern functions/lib --ignore-pattern functions/node_modules"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "firebase": "^12.18.0",
    "lucide-react": "^1.34.0",
    "next": "^16.3.2",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.86.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.53.1",
    "@cloudflare/workers-types": "^5.20260825.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "cross-env": "^10.1.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "^19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "^8.2.2",
    "wrangler": "^4.125.0"
  },
  "type": "module"
}
